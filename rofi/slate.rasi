/**
 * Compact prompt for slate (e.g. "Save / Discard / Cancel").
 *
 * Colors: your ~/.config/rofi/colors.rasi is additionally loaded on each call,
 * if it exists (slate passes it via -theme-str). If it is missing, the
 * values after the comma in var(...) apply (Tokyo Night Storm).
 */
* {
    background:     var(base03, #24283b);
    background-alt: var(base02, #414868);
    foreground:     var(white, #c0caf5);
    dimmed:         var(base00, #9aa5ce);
    selected:       var(blue, #7aa2f7);
    frame:          var(base01, #565f89);
}

window {
    location:         center;
    anchor:           center;
    width:            460px;
    padding:          18px;
    border:           1px;
    border-radius:    8px;
    border-color:     @frame;
    background-color: @background;
}

mainbox {
    children:         [ message, inputbar, listview ];
    spacing:          14px;
    background-color: transparent;
}

message {
    background-color: transparent;
}

textbox {
    text-color:       @foreground;
    background-color: transparent;
}

/* Input line for the fuzzy search: typing filters the choices, Enter takes the top one */
inputbar {
    children:         [ entry ];
    padding:          7px 12px;
    border-radius:    5px;
    background-color: @background-alt;
}

entry {
    placeholder:       "type to filter …";
    placeholder-color: @dimmed;
    text-color:        @foreground;
    background-color:  transparent;
}

listview {
    lines:            3;
    columns:          1;
    fixed-height:     false;
    scrollbar:        false;
    spacing:          4px;
    background-color: transparent;
}

element {
    padding:          7px 12px;
    border-radius:    5px;
    background-color: transparent;
    text-color:       @dimmed;
}

element selected.normal {
    background-color: @background-alt;
    text-color:       @selected;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
}
